# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/
out/
*.tsbuildinfo

# Electron
release/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Env
.env
.env.local
.env.*.local

# SQLite
*.db
*.db-journal
*.sqlite

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Turbo build cache — binary .tar.zst archives, machine-local, regenerated on
# every run. Must never be versioned: git pull/checkout restoring stale cache
# files crashes the turbo binary on startup (0xC0000409).
.turbo/

# ZCode session artifacts (local planning drafts, scratch)
.zcode/

# Pi runtime meta-package build output (22MB tarball + staging tree, produced
# by apps/desktop/build/pack-pi-runtime.cjs; republish via npm, never commit)
apps/desktop/build/pi-runtime-dist/

# 本地临时目录(运行残留的 scratch,与仓库无关)
.tmp/
.scholar_tmp/
.claude/

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*

# 本地审查台账与审查规范（不进入版本控制）
/audit-ledgers/

# 双锁文件防再生:唯一安装器是 pnpm(见 package.json 的 packageManager)。
# 根 package-lock.json 是历史遗留的第二套安装输入(约束已与 pnpm-lock 分叉),
# 已删除;若被 npm 命令意外重新生成,不入版本控制(2026-10-17,MC-038)。
/package-lock.json

# GenOffice 开源文档内核(vendor 快照,固定 commit 1f306a2;见 docs/planning/genoffice-integration-frontend-redesign.md)
/genoffice/
# Node-RED 5.0.8 原厂源码，固定 935b8d3，独立 git 分支 mcode/integration
/node-red/
# open-claude-ui(ARC-005 的 CDS 令牌与组件参考;MIT;token 由 apps/desktop/scripts/gen-cds-tokens.mjs 提取)
/open-claude-ui/

# ── 以下三条是 2026-10-28 逐项核实后加的（不是批量正则）──

# 第三方仓库克隆：orca/ 是 github.com/stablyai/orca 的完整检出
#（501 MB、38966 个文件、自带 .git）。它和 genoffice/ node-red/ 一样是
#「参考/复用来源」，不是本仓源码 —— 进版本库会把仓库撑爆。
/orca/

# 构建误产物掉在仓库根：KaTeX 的 60 个字体文件本该落在
# apps/desktop/out/renderer/assets/（那里有正确的一份），
# 这 60 个是构建时 cwd 不对留下的。已在根目录逐个确认后才写这条。
/KaTeX_*.woff
/KaTeX_*.woff2
/KaTeX_*.ttf
# `> nul` 重定向打错留下的 CSS 副本（106 KB，内容是 ClaudeCodeBlock.css）。
# \`nul\` 是 Windows 保留设备名，正常构建不可能产出它。
/nul.css

# 一次性探针脚本（`.tmp-` 前缀是本仓既有约定，见 CLAUDE.md 硬规矩 5：
# 临时脚本先写文件再执行）。它们散落在 apps/desktop 与 scripts/ 下，
# 逐个确认都是调试用的一次性脚本，不是套件。
/apps/desktop/.tmp-*
/apps/desktop/scripts/.tmp-*


# Turbo build cache — binary .tar.zst archives, machine-local, regenerated on
# every run. Must never be versioned: git pull/checkout restoring stale cache
# files crashes the turbo binary on startup (0xC0000409).
.turbo/

# ZCode session artifacts (local planning drafts, scratch)
.zcode/

# Pi runtime meta-package build output (22MB tarball + staging tree, produced
# by apps/desktop/build/pack-pi-runtime.cjs; republish via npm, never commit)
apps/desktop/build/pi-runtime-dist/

# 本地临时目录(运行残留的 scratch,与仓库无关)
.tmp/
.scholar_tmp/
.claude/

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*

# 本地审查台账与审查规范（不进入版本控制）
/audit-ledgers/

# 双锁文件防再生:唯一安装器是 pnpm(见 package.json 的 packageManager)。
# 根 package-lock.json 是历史遗留的第二套安装输入(约束已与 pnpm-lock 分叉),
# 已删除;若被 npm 命令意外重新生成,不入版本控制(2026-10-17,MC-038)。
/package-lock.json

# GenOffice 开源文档内核(vendor 快照,固定 commit 1f306a2;见 docs/planning/genoffice-integration-frontend-redesign.md)
/genoffice/

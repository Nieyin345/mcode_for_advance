{
  "name": "@mcode/desktop",
  "version": "0.1.60",
  "private": true,
  "description": "Mcode - Desktop GUI for Claude Code",
  "author": "huangbh",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node build/ensure-electron.cjs",
    "dev": "electron-vite dev",
    "build": "node --max-old-space-size=8192 node_modules/electron-vite/bin/electron-vite.js build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test scripts/run-smokes.test.mjs && node scripts/run-smokes.mjs --critical",
    "test:all": "node --test scripts/run-smokes.test.mjs && node scripts/run-smokes.mjs --all",
    "test:smoke": "node scripts/run-smokes.mjs",
    "test:runner": "node --test scripts/run-smokes.test.mjs",
    "rebuild:native": "node build/rebuild-native.cjs",
    "pack:pi-runtime": "node build/pack-pi-runtime.cjs",
    "package": "pnpm run build && node -e \"require('fs').rmSync('../../packages/contracts/dist',{recursive:true,force:true})\" && node build/dereference-workspace-symlinks.cjs && electron-builder --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@mcode/contracts": "workspace:*",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "4.10.38",
    "sherpa-onnx-node": "1.13.6",
    "sherpa-onnx-win-x64": "1.13.6",
    "simple-git": "^3.36.0",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "tar": "^7.4.3",
    "typebox": "1.3.7",
    "zod": "3.25.76",
    "zod-to-json-schema": "~3.23.5"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@embedpdf/react-pdf-viewer": "^2.15.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/material-icon-theme": "^1.2.70",
    "@iconify/react": "^6.0.2",
    "@js-preview/excel": "^1.7.14",
    "@legendapp/list": "3.0.0-beta.44",
    "@milkdown/crepe": "^7.22.2",
    "@milkdown/kit": "^7.22.2",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex": "0.153.4",
    "@shikijs/transformers": "^4.3.1",
    "@tabler/icons-react": "^3.45.0",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.4.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "3.1.0",
    "katex": "0.16.47",
    "lxgw-wenkai-webfont": "^1.7.0",
    "monaco-editor": "^0.56.0",
    "postcss": "^8.4.49",
    "pptx-preview": "^1.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "overrides": {
      "lexical": "0.48.0"
    }
  }

{
  "name": "mcode",
  "private": true,
  "version": "0.0.0",
  "description": "Mcode - free, open-source desktop GUI for coding agents. A three-pane AI IDE built on the Claude Agent SDK and Pi Coding Agent: real-time streaming chat, tool approval, plan mode, Monaco editor, git, terminal, embedded browser, LSP and mobile remote control. MIT licensed.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --ui stream",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:all": "pnpm --filter @mcode/desktop test:all",
    "test:smoke": "pnpm --filter @mcode/desktop test:smoke",
    "test:runner": "pnpm --filter @mcode/desktop test:runner",
    "lint": "turbo run lint",
    "audit:deps": "pnpm audit --registry=https://registry.npmjs.org",
    "package": "turbo run package"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.7.0"
  }
}

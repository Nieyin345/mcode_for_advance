diff --git a/packages/ui/src/mcode-host.ts b/packages/ui/src/mcode-host.ts
new file mode 100644
index 0000000..5fb579f
--- /dev/null
+++ b/packages/ui/src/mcode-host.ts
@@ -0,0 +1,9 @@
+/**
+ * Only the Mcode desktop product embeds these editor views. Do not infer host
+ * ownership from a preload namespace: standalone GenOffice also exposes one.
+ * Match the same Electron product UA used by the native Mcode theme gate.
+ */
+export function isMcodeHostedUi(userAgent?: string): boolean {
+  const ua = userAgent ?? (typeof navigator === 'undefined' ? '' : navigator.userAgent)
+  return /\bMcode\//.test(ua)
+}
diff --git a/packages/ui/tests/mcode-host.test.ts b/packages/ui/tests/mcode-host.test.ts
new file mode 100644
index 0000000..c4c43dd
--- /dev/null
+++ b/packages/ui/tests/mcode-host.test.ts
@@ -0,0 +1,18 @@
+import { describe, expect, it } from 'vitest'
+import { isMcodeHostedUi } from '../src/mcode-host'
+
+describe('Mcode-owned Office renderer mode', () => {
+  it('matches the Electron Mcode product identity used by editor theme gates', () => {
+    expect(isMcodeHostedUi('Mozilla/5.0 Mcode/44.4.5 Electron/44.4.5')).toBe(true)
+    expect(isMcodeHostedUi('Mcode/44.4.5')).toBe(true)
+  })
+  it('does not remove vendor AI from standalone GenOffice desktop apps', () => {
+    for (const ua of ['GenOfficeSlides/44.4.5', 'GenOfficePDF/44.4.5', 'Mozilla/5.0']) {
+      expect(isMcodeHostedUi(ua)).toBe(false)
+    }
+  })
+  it('rejects a misleading token embedded in a longer product name', () => {
+    expect(isMcodeHostedUi('NotMcode/44.4.5')).toBe(false)
+    expect(isMcodeHostedUi('')).toBe(false)
+  })
+})

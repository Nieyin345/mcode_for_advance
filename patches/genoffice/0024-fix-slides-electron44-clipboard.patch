new file mode 100644
index 0000000..f293796
--- /dev/null
+++ b/apps/slides/src/main/clipboard-compat.ts
@@ -0,0 +1,114 @@
+/**
+ * Slides clipboard adapter across Electron <=43 (sync clipboard helpers)
+ * and Electron 44+ (async ClipboardItem API).
+ *
+ * Keep all platform clipboard access in the main process. Raw app markers are
+ * OS-specific custom formats, not arbitrary renderer-supplied MIME names.
+ */
+import { clipboard, nativeImage } from 'electron'
+import * as electron from 'electron'
+
+const rawFormat = (name: string): string => `electron application/osclipboard;format="${name}"`
+
+type Item = { types: readonly string[]; getType(type: string): Promise<Blob> }
+const modern = clipboard as unknown as {
+  read(): Promise<Item[]>
+  readText(): Promise<string>
+  write(items: unknown[]): Promise<void>
+}
+const legacy = clipboard as unknown as {
+  availableFormats?(): string[]
+  readBuffer?(name: string): Buffer
+  writeBuffer?(name: string, bytes: Buffer): void
+  readHTML?(): string
+  readImage?(): { isEmpty(): boolean; toPNG(): Buffer }
+  readText?(): string
+  write?(input: { image: ReturnType<typeof nativeImage.createFromBuffer>; html: string }): void
+}
+const ItemCtor = () =>
+  (electron as unknown as { ClipboardItem: new (data: Record<string, Blob | string>) => unknown }).ClipboardItem
+
+function isLegacy(): boolean {
+  return typeof legacy.availableFormats === 'function'
+}
+
+export async function readRawClipboardMarker(name: string): Promise<Buffer | null> {
+  if (typeof legacy.readBuffer === 'function') {
+    try {
+      const bytes = legacy.readBuffer(name)
+      return bytes.length ? bytes : null
+    } catch {
+      return null
+    }
+  }
+  const mime = rawFormat(name)
+  const items = await modern.read()
+  const item = items.find((entry) => entry.types.includes(mime))
+  if (!item) return null
+  const blob = await item.getType(mime)
+  const bytes = Buffer.from(await blob.arrayBuffer())
+  return bytes.length ? bytes : null
+}
+
+export async function writeRawClipboardMarker(name: string, bytes: Buffer): Promise<void> {
+  if (typeof legacy.writeBuffer === 'function') {
+    legacy.writeBuffer(name, bytes)
+    return
+  }
+  await modern.write([new (ItemCtor())({
+    [rawFormat(name)]: new Blob([new Uint8Array(bytes)]),
+  })])
+}
+
+export async function readClipboardHtml(): Promise<string> {
+  if (typeof legacy.readHTML === 'function') return legacy.readHTML()
+  const items = await modern.read()
+  const item = items.find((entry) => entry.types.includes('text/html'))
+  if (!item) return ''
+  return (await item.getType('text/html')).text()
+}
+
+export async function readClipboardText(): Promise<string> {
+  return Promise.resolve(clipboard.readText() as unknown as string | Promise<string>)
+}
+
+export async function readClipboardImagePng(): Promise<Buffer | null> {
+  if (typeof legacy.readImage === 'function') {
+    const image = legacy.readImage()
+    return image.isEmpty() ? null : image.toPNG()
+  }
+  const items = await modern.read()
+  const imageType = ['image/png', 'image/jpeg', 'image/webp'].find(
+    (type) => items.some((item) => item.types.includes(type)),
+  )
+  if (!imageType) return null
+  const item = items.find((entry) => entry.types.includes(imageType))!
+  const blob = await item.getType(imageType)
+  const image = nativeImage.createFromBuffer(Buffer.from(await blob.arrayBuffer()))
+  return image.isEmpty() ? null : image.toPNG()
+}
+
+export async function clipboardHasPasteableContent(): Promise<boolean> {
+  if (isLegacy()) {
+    if (legacy.availableFormats!().some((format) => format.startsWith('image/'))) return true
+  } else {
+    const items = await modern.read()
+    if (items.some((entry) => entry.types.some((type) => type.startsWith('image/')))) return true
+  }
+  return (await readClipboardText()).trim().length > 0
+}
+
+export async function writeClipboardImageWithHtml(
+  png: Buffer,
+  html: string,
+  normalizedImage?: ReturnType<typeof nativeImage.createFromBuffer>,
+): Promise<void> {
+  if (isLegacy()) {
+    legacy.write!({ image: normalizedImage ?? nativeImage.createFromBuffer(png), html })
+    return
+  }
+  await modern.write([new (ItemCtor())({
+    'image/png': new Blob([new Uint8Array(png)], { type: 'image/png' }),
+    'text/html': html,
+  })])
+}

diff --git a/apps/slides/tests/clipboard-compat.test.ts b/apps/slides/tests/clipboard-compat.test.ts
new file mode 100644
index 0000000..8aa8206
--- /dev/null
+++ b/apps/slides/tests/clipboard-compat.test.ts
@@ -0,0 +1,93 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+const electron = vi.hoisted(() => {
+  class ClipboardItem {
+    readonly data: Record<string, Blob | string>
+    constructor(data: Record<string, Blob | string>) {
+      this.data = data
+    }
+  }
+  return {
+    ClipboardItem,
+    clipboard: { read: vi.fn(), readText: vi.fn(), write: vi.fn() },
+    nativeImage: { createFromBuffer: vi.fn() },
+  }
+})
+vi.mock('electron', () => electron)
+
+import {
+  clipboardHasPasteableContent,
+  readClipboardHtml,
+  readClipboardImagePng,
+  readClipboardText,
+  readRawClipboardMarker,
+  writeClipboardImageWithHtml,
+  writeRawClipboardMarker,
+} from '../src/main/clipboard-compat'
+import { elementClipboardMarkerMatches } from '../src/main/element-clipboard'
+
+const rawType = (name: string) => `electron application/osclipboard;format="${name}"`
+const item = (mime: string, bytes: string | Uint8Array) => ({
+  types: [mime],
+  getType: vi.fn(async () => new Blob([typeof bytes === 'string' ? bytes : new Uint8Array(Array.from(bytes))])),
+})
+
+beforeEach(() => {
+  electron.clipboard.read.mockReset().mockResolvedValue([])
+  electron.clipboard.readText.mockReset().mockResolvedValue('')
+  electron.clipboard.write.mockReset().mockResolvedValue(undefined)
+  electron.nativeImage.createFromBuffer.mockReset().mockReturnValue({
+    isEmpty: () => false, toPNG: () => Buffer.from('png-normalized'),
+  })
+})
+
+describe('Electron 44 async clipboard migration', () => {
+  it('reads a custom raw marker and rejects a replaced marker', async () => {
+    electron.clipboard.read.mockResolvedValue([item(rawType('io.genoffice.slides.elements'), 't-1')])
+    expect((await readRawClipboardMarker('io.genoffice.slides.elements'))?.toString()).toBe('t-1')
+    expect(await elementClipboardMarkerMatches('t-1')).toBe(true)
+    expect(await elementClipboardMarkerMatches('t-2')).toBe(false)
+  })
+
+  it('writes custom raw marker as a single ClipboardItem, without the removed writeBuffer API', async () => {
+    await writeRawClipboardMarker('io.genoffice.slides.slide', Buffer.from('1'))
+    expect(electron.clipboard.write).toHaveBeenCalledTimes(1)
+    const [entries] = electron.clipboard.write.mock.calls[0]!
+    expect(entries).toHaveLength(1)
+    const stored = entries[0].data[rawType('io.genoffice.slides.slide')] as Blob
+    expect(Buffer.from(await stored.arrayBuffer()).toString()).toBe('1')
+  })
+
+  it('reads external image data as normalized PNG and preserves image priority over text', async () => {
+    electron.clipboard.read.mockResolvedValue([item('image/jpeg', new Uint8Array([1, 2, 3]))])
+    electron.clipboard.readText.mockResolvedValue('external text')
+    expect(await clipboardHasPasteableContent()).toBe(true)
+    expect((await readClipboardImagePng())?.toString()).toBe('png-normalized')
+    expect(electron.nativeImage.createFromBuffer).toHaveBeenCalledWith(Buffer.from([1, 2, 3]))
+  })
+
+  it('reads HTML and text without the removed readHTML helper', async () => {
+    electron.clipboard.read.mockResolvedValue([item('text/html', '<b>copy</b>')])
+    electron.clipboard.readText.mockResolvedValue('copied')
+    expect(await readClipboardHtml()).toBe('<b>copy</b>')
+    expect(await readClipboardText()).toBe('copied')
+  })
+
+  it('writes image and HTML together in a single modern clipboard transaction', async () => {
+    await writeClipboardImageWithHtml(Buffer.from('png-data'), '<b>image</b>')
+    expect(electron.clipboard.write).toHaveBeenCalledTimes(1)
+    const [entries] = electron.clipboard.write.mock.calls[0]!
+    const data = entries[0].data
+    expect(Object.keys(data).sort()).toEqual(['image/png', 'text/html'])
+    expect(Buffer.from(await (data['image/png'] as Blob).arrayBuffer()).toString()).toBe('png-data')
+    expect(data['text/html']).toBe('<b>image</b>')
+  })
+
+  it('reports no paste content on empty image items and whitespace-only text', async () => {
+    electron.clipboard.read.mockResolvedValue([item('application/json', '{}')])
+    electron.clipboard.readText.mockResolvedValue('   ')
+    expect(await clipboardHasPasteableContent()).toBe(false)
+    expect(await readClipboardImagePng()).toBeNull()
+    expect(await readRawClipboardMarker('io.genoffice.slides.slide')).toBeNull()
+  })
+})

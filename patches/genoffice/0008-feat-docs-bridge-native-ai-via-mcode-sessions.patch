   activeOwners.add(owner)
   if (releaseNativeHandlers !== null) return () => { activeOwners.delete(owner) }
   const authorized = (event: { sender?: unknown }): boolean => {
@@ -266,7 +268,14 @@ export function registerDocsIpc(
     }
     return null
   })
+  const releaseAi = registerDocsAiIpc(ipc, (sender) => {
+    for (const host of activeOwners) {
+      try { if (host.guard(sender) === true) return host.ai(sender) } catch { /* fail closed */ }
+    }

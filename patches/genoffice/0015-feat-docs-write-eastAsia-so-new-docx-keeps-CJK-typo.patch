@@ -345,8 +345,19 @@ export async function exportDocxBytes(
   doc: JSONContent,
   loadImage: ImageLoader,
   renderDiagram?: DiagramRenderer,
+  /**
+   * 【T115】写进 `docDefaults` 的 East Asian 字体（`w:eastAsia`）。
+   *
+   * **由调用方决定，不从 `process.platform` 推** —— 这个模块是纯函数，既不假设自己

new file mode 100644
index 0000000..0201cc0
--- /dev/null
+++ b/packages/cli/src/formats/east-asia-font.ts
@@ -0,0 +1,57 @@
+/**
+ * 【T115】新建 docx 时写进 `docDefaults` 的 East Asian 字体。
+ *
+ * ## 为什么必须有这个值
+ *
+ * Word 的 `w:rFonts` 分三个槽：`w:ascii`（西文）、`w:hAnsi`（西文回退）、
+ * `w:eastAsia`（CJK）。**不写 `w:eastAsia` 时**，Word 与我们的渲染器会按脚本
+ * **回退到系统默认的中文字体** —— 后果不是「缺字」，是：
+ *
+ *   - 中文字形来自系统默认（Windows 上通常是宋体），**西文来自 Calibri**；
+ *   - **行高按西文字体的度量算**，中文字符撑破行距；
+ *   - **字重不一致** —— 用户看到的是一段里混了两种字体。
+ *
+ * 这就是「AI 改 Word 又烂又丑」最直接的一条。写一个 `w:eastAsia` 就把它消掉。
+ *
+ * ## 为什么按平台选，而不是钉死一个
+ *
+ * 这三个字体各自只在自己平台上保证存在：
+ *
+ * | 字体 | Windows | macOS | Linux |
+ * |---|---|---|---|
+ * | `Microsoft YaHei` | ✅（系统自带，现代无衬线默认） | ❌ | ❌ |
+ * | `PingFang SC` | ❌ | ✅（系统自带） | ❌ |
+ * | `Noto Sans CJK SC` | 部分 | 部分 | ✅ |
+ *
+ * **写死的后果**：在别的平台打开时字体不存在，Word 回退到系统默认 ——
+ * **那和完全不写 `w:eastAsia` 的结果一样**，还多了一行误导人的声明。
+ *
+ * 所以按**生成这份文件的机器**挑。代价是：**同一个 Mcode 在 Windows 和 macOS 上
+ * 产出的 docx 字节不同**（`w:eastAsia` 的值不一样）。这是有意的取舍 ——
+ * 可复现性让位于「在这台机器上打开是好看的」。跨平台比对产物字节的断言不存在，
+ * 也不应该有（T115 查过：全仓只有「同一文件改前改后」的哈希对比）。
+ *
+ * ⚠️ **`Microsoft YaHei` 不是宋体。** 雅黑是 Windows 上的现代无衬线默认；宋体
+ * （SimSun）是旧式衬线，在屏幕上的观感正是用户抱怨的那种。
+ */
+import { platform } from 'node:os'
+
+/**
+ * 当前平台应当写进 `docDefaults` 的 East Asian 字体。
+ *
+ * 返回 `undefined` 表示这个平台没有我们能担保存在的 CJK 字体 —— **宁可什么都不写**
+ * （让 Word 按脚本回退），也不要写一个大概率不存在的名字。
+ */
+export function defaultEastAsiaFont(): string | undefined {
+  switch (platform()) {
+    case 'win32':
+      return 'Microsoft YaHei'
+    case 'darwin':
+      return 'PingFang SC'
+    case 'linux':
+      return 'Noto Sans CJK SC'
+    default:
+      // FreeBSD / Android 等：没有可担保的字体，交给渲染器回退。
+      return undefined
+  }
+}

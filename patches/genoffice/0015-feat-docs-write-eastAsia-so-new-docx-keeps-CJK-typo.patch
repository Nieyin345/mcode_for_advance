 packages/cli/src/formats/docx.ts              |  7 ++-
 packages/cli/src/formats/east-asia-font.ts    | 57 +++++++++++++++++++
 packages/cli/src/formats/markdown.ts          | 11 +++-
 4 files changed, 85 insertions(+), 3 deletions(-)
 create mode 100644 packages/cli/src/formats/east-asia-font.ts


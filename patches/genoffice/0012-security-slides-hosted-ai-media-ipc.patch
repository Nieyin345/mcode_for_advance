diff --git a/apps/slides/src/main/slides-ai-boundary.ts b/apps/slides/src/main/slides-ai-boundary.ts
new file mode 100644
index 0000000..74e41e9
--- /dev/null
+++ b/apps/slides/src/main/slides-ai-boundary.ts
@@ -0,0 +1,49 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Mcode-specific boundary for the original Slides AI/media IPC handlers.
+ * The upstream algorithms remain unchanged; Hosted mode fails closed until
+ * the capability is explicitly integrated with Mcode's approval/session path.
+ */
+import type { IpcMain } from 'electron'
+
+export const SLIDES_ONLY_AI_CHANNELS = [
+  'ai:generate-image',
+  'ai:analyze-media',
+  'ai:insert-image-url',
+  'ai:replace-picture-url',
+  'ai:save-sidecar',
+  'ai:save-style-template',
+  'ai:list-style-templates',
+  'ai:load-style-template',
+] as const
+
+export const MCODE_SLIDES_AI_UNAVAILABLE =
+  'Mcode 宿主尚未授权 Slides 原厂云 AI／媒体能力；请通过 Mcode 已审批的 AI 能力操作。'
+
+/**
+ * Register the original handlers only for standalone GenOffice.
+ *
+ * Mcode-hosted Slides currently has no approval/session-aware adapter for
+ * these independent handlers. Install readable denials under the same channel
+ * names instead of leaving them reachable through raw ipcMain. This is
+ * intentionally fail-closed for every sender until a separate approved
+ * adapter can bind sender + file + session + version at invocation time.
+ */
+export function registerSlidesAiBoundary(
+  ipc: Pick<IpcMain, 'handle'>,
+  isMcodeHosted: boolean,
+  registerOriginal: () => void,
+): 'blocked' | 'standalone' {
+  if (!isMcodeHosted) {
+    registerOriginal()
+    return 'standalone'
+  }
+
+  for (const channel of SLIDES_ONLY_AI_CHANNELS) {
+    ipc.handle(channel, () => {
+      throw new Error(MCODE_SLIDES_AI_UNAVAILABLE)
+    })
+  }
+  return 'blocked'
+}
diff --git a/apps/slides/src/main/slides-main.ts b/apps/slides/src/main/slides-main.ts
index f9d42e3..b2379d0 100644
--- a/apps/slides/src/main/slides-main.ts
+++ b/apps/slides/src/main/slides-main.ts
@@ -4832,7 +4832,7 @@ export function registerSlidesIpc(): void {
   // aggregate mode only calls this function) ──
   registerPresenterIpc()
 
-  registerSlidesOnlyAiIpc()
+  registerSlidesOnlyAiIpc(mcodePane.isMcodeHosted())
 }
 

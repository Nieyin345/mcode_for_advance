+  --text-secondary: #606366;
+  --text-muted: #616870;
+  --text-tertiary: #909499;
+  --text-dim: #605e5c;
+  --hover: #f5f5f5;
+  --pressed: #edebe9;
+  --active-bg: #eaeaea;
+  --icon-muted: #b9bfc7;
+  --danger: #d13438;
+  --danger-bg: #fdf3f3;
+}
+
+[data-theme='dark'] .doc-page {
+  /* 暗色上游值（tokens.css [data-theme='dark']） */
+  --surface: #1e1e1e;
+  --surface-subtle: #2a2a2a;
+  --bg-content: #1a1a1a;

@@ -0,0 +1,208 @@
+/**
+ * T54: per-pane security boundary for GenOffice's original IPC handlers.
+ *
+ * The original handlers remain the implementation; only their invoke/sender
+ * boundary and the native file picker results are constrained by Mcode.
+ * No host means standalone GenOffice behavior is unchanged.
+ */
+import { AsyncLocalStorage } from 'node:async_hooks'
+import { isAbsolute, join } from 'node:path'
+import { dialog as electronDialog, ipcMain as electronIpcMain } from 'electron'
+import type { Dialog, IpcMain } from 'electron'
+
+export type McodePaneKind = 'sheets' | 'slides'
+export interface McodePaneGuard {
+  ownsSender(sender: unknown): boolean
+  containsPath(path: string): boolean
+  documentPath(sender: unknown): string | null
+  audit(channel: string, category: 'A' | 'B' | 'C', outcome: string): void
+}
+
+interface CallScope {
+  sender: unknown
+  guard: McodePaneGuard
+}
+
+const SHEETS_BLOCKED = new Set([
+  'sheets:capture-screen-sources',
+  'sheets:capture-screen-source',
+])
+const SLIDES_BLOCKED = new Set([
+  'slides:font-install-local',
+  'slides:font-download',
+  'slides:save-recording',
+  'slides:microphone-access',
+])
+const ALLOWED_EFFECTS = new Set([
+  'workbook:print', 'workbook:list-printers', 'shell:open-external',
+  'slides:print', 'slides:show-fullscreen',
+])
+const PATH_OPERATIONS = new Set([
+  'workbook:select', 'workbook:select-for-merge', 'workbook:reopen',
+  'workbook:open-for-merge', 'workbook:save', 'workbook:export-pdf',
+  'workbook:export-csv', 'workbook:create-document', 'shell:read-local-image',
+  'sheets:files-pick', 'sheets:files-add', 'sheets:files-read-image',
+  'slides:open', 'slides:open-path', 'slides:save', 'slides:save-as',
+  'slides:edit-background', 'slides:edit-image-fill', 'slides:pick-picture-file',
+  'slides:insert-image', 'slides:insert-media', 'slides:insert-model3d',
+  'slides:add-media-bytes',
+  'slides:pick-export-dir', 'slides:export-images',
+  'slides:pick-export-pdf-path', 'slides:save-picture', 'slides:export-pdf',
+])
+
+function category(channel: string): 'A' | 'B' | 'C' | null {
+  if (SHEETS_BLOCKED.has(channel) || SLIDES_BLOCKED.has(channel)) return 'B'
+  if (ALLOWED_EFFECTS.has(channel)) return 'C'
+  if (PATH_OPERATIONS.has(channel)) return 'A'
+  return null
+}
+
+function assertAllowedPath(guard: McodePaneGuard, channel: string, candidate: unknown): void {
+  if (typeof candidate !== 'string' || !candidate || !isAbsolute(candidate) ||
+      !guard.containsPath(candidate)) {
+    guard.audit(channel, 'A', 'denied: outside Mcode workspace')
+    throw new Error('Mcode 工作区围栏：文件路径不在已授权的工作区内')
+  }
+}
+
+function directPaths(channel: string, args: unknown[]): unknown[] {
+  const op = args[0] as Record<string, unknown> | undefined
+  switch (channel) {
+    case 'workbook:reopen':
+    case 'slides:open-path':
+    case 'sheets:files-read-image':
+      return [args[0]]
+    case 'workbook:open-for-merge':
+    case 'sheets:files-add':
+      return Array.isArray(args[0]) ? args[0] : [null]
+    case 'shell:read-local-image':
+      return [op?.path]
+    case 'workbook:save':
+    case 'workbook:export-csv':
+      return op?.targetPath === undefined ? [] : [op.targetPath]
+    case 'workbook:export-pdf':
+      return op?.outPath === undefined ? [] : [op.outPath]
+    case 'slides:export-images': {
+      // The renderer controls both the directory and basename; a ../ basename
+      // would otherwise escape after joining. Guard the *resulting* filename.
+      if (typeof op?.dir !== 'string' || typeof op.baseName !== 'string' ||
+          op.baseName.length === 0 || op.baseName.includes(String.fromCharCode(0)) ||
+          !Array.isArray(op.pngsBase64) || op.pngsBase64.length > 1000) return [null]
+      const padding = op.pngsBase64.length >= 100 ? 3 : 2
+      return [op.dir, ...op.pngsBase64.map((_, i) =>
+        join(op.dir as string, `${op.baseName}-${String(i + 1).padStart(padding, '0')}.png`))]
+    }
+    case 'slides:export-pdf':
+      return [op?.filePath]
+    case 'slides:add-media-bytes':
+      return op && 'path' in op ? [op.path] : []
+    default:
+      return []
+  }
+}
+
+function isScopedChannel(channel: string): boolean {
+  return /^(?:slides:|sheets:|workbook:|shell:)/.test(channel)
+}
+
+export function createMcodePaneIpc(
+  upstreamIpc: IpcMain,
+  upstreamDialog: Dialog,
+  kind: McodePaneKind,
+): {
+  ipcMain: IpcMain
+  dialog: Dialog
+  configure(guard: McodePaneGuard | undefined): void
+  isMcodeHosted(): boolean
+  defaultDocumentDirectory(sender: unknown): string | null
+} {
+  let guard: McodePaneGuard | undefined
+  const current = new AsyncLocalStorage<CallScope>()
+
+  const check = (channel: string, sender: unknown, args: unknown[]): McodePaneGuard | null => {
+    if (!guard || !isScopedChannel(channel)) return null
+    if (!guard.ownsSender(sender)) {
+      throw new Error('Mcode 安全围栏：未授权的文档视图不能调用原厂 IPC')
+    }
+    const group = category(channel)
+    if (group === 'B') {
+      guard.audit(channel, group, 'denied')
+      throw new Error('Mcode 安全限制：屏幕采集／录制或本机字体安装尚未授权')
+    }
+    if (channel === 'shell:open-external') {
+      const link = args[0]
+      if (typeof link !== 'string' || !/^https?:\/\//i.test(link)) {
+        guard.audit(channel, 'C', 'denied: non-http(s) URL')
+        throw new Error('Mcode 安全限制：只允许打开 HTTP/HTTPS 外部链接')
+      }
+    }
+    for (const path of directPaths(channel, args)) assertAllowedPath(guard, channel, path)
+    // Implicit save must target a document already admitted by DocumentViewHost;
+    // anonymous draft saves in the vendor's global default directory are unsafe.
+    if (channel === 'slides:save') {
+      assertAllowedPath(guard, channel, guard.documentPath(sender))
+    }
+    if (group) guard.audit(channel, group, 'allowed')
+    return guard
+  }
+
+  const ipcMain = new Proxy(upstreamIpc, {
+    get(target, prop, receiver) {
+      if (prop === 'handle') return (channel: string, handler: (...args: any[]) => unknown) =>
+        target.handle(channel, (event, ...args) => {
+          const owner = check(channel, event.sender, args)
+          return owner ? current.run({ sender: event.sender, guard: owner }, () => handler(event, ...args))
+            : handler(event, ...args)
+        })
+      if (prop === 'on') return (channel: string, listener: (...args: any[]) => void) =>
+        target.on(channel, (event, ...args) => {
+          const owner = check(channel, event.sender, args)
+          if (owner) current.run({ sender: event.sender, guard: owner }, () => listener(event, ...args))
+          else listener(event, ...args)
+        })
+      const value = Reflect.get(target, prop, receiver) as unknown
+      return typeof value === 'function' ? value.bind(target) : value
+    },
+  }) as IpcMain
+
+  // Pickers are invoked deep inside original handlers. Validating only their
+  // input would miss the *chosen* write target: validate returned paths before
+  // the original code can read, write, or install anything.
+  const dialog = new Proxy(upstreamDialog, {
+    get(target, prop, receiver) {
+      if (prop === 'showOpenDialog' || prop === 'showSaveDialog') return async (...args: unknown[]) => {
+        const session = current.getStore()
+        if (guard && !session) throw new Error('Mcode 安全围栏：文件对话框没有已验证的视图来源')
+        const method = target[prop].bind(target) as (...params: unknown[]) => Promise<unknown>
+        const response = await method(...args)
+        if (session && response && typeof response === 'object') {
+          const result = response as { canceled?: boolean; filePath?: string; filePaths?: string[] }
+          if (!result.canceled) {
+            for (const file of result.filePaths ?? (result.filePath ? [result.filePath] : [])) {
+              assertAllowedPath(session.guard, String(prop), file)
+            }
+          }
+        }
+        return response
+      }
+      const value = Reflect.get(target, prop, receiver) as unknown
+      return typeof value === 'function' ? value.bind(target) : value
+    },
+  }) as Dialog
+
+  return {
+    ipcMain,
+    dialog,
+    configure(next) { guard = next },
+    isMcodeHosted: () => guard !== undefined,
+    defaultDocumentDirectory(sender) {
+      if (!guard || !guard.ownsSender(sender)) return null
+      const path = guard.documentPath(sender)
+      if (!path || !isAbsolute(path) || !guard.containsPath(path)) return null
+      return path
+    },
+  }
+}
+
+/** Shared with the PDF exporter, which must use the SAME async IPC context. */
+export const mcodeSheetsPane = createMcodePaneIpc(electronIpcMain, electronDialog, 'sheets')

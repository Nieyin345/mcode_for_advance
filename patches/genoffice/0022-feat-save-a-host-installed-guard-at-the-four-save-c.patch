+      // 失败路径的断言见 O2 套件的 `o10-slides-failed-rename` 旅程。
+      await guardedDocumentSave({
+        target: session.path,
+        format: 'slides',
+        write: async () => {
+          // 暂存写 + 原子替换交给**共享实现**（`electron-utils` 的 stagedAtomicWrite）：
+          // 失败路径的三段结构（写暂存失败才删；替换失败不删、退回原地写；两次都失败
+          // 则保留暂存并点名位置）在那里有纯 Node 断言，不在本调用点重复。
+          await stagedAtomicWrite({
+            target: session.path,
+            staging: join(dirname(session.path), `.${basename(session.path)}.${randomUUID()}.mcode-saving`),
+            writeTo: (path) => savePptxToFile(session.opened, path),
+          })
+        },
+      })
       autosaveBackoff.delete(session.path)
       void rm(autosavePathFor(session.path), { force: true }).catch(() => {})
       dropUntitledRecovery(e.sender.id)

diff --git a/packages/electron-utils/src/document-save-guard.ts b/packages/electron-utils/src/document-save-guard.ts
new file mode 100644
index 0000000..793ef89
--- /dev/null
+++ b/packages/electron-utils/src/document-save-guard.ts
@@ -0,0 +1,143 @@
+/**
+ * 保存写盘的**唯一出口**（Mcode Host 会在装配期装一个守卫进来）。
+ *
+ * ## 为什么需要这个接缝（以及它不是「给 vendor 打补丁」）
+ *
+ * `atomic-write.ts` 的注释已经把责任边界写明了：
+ *
+ * > This primitive protects temporary-file ownership.
+ * > The caller/Host must still enforce the source version and file lease for concurrent editors.
+ *
+ * 也就是说：**原子写只保证「不会写坏」，版本校验与文件租约是 Host 的事。**
+ * 这个模块就是那一半的插口 —— vendor 的保存调用点从这里出去，Mcode 在装配期
+ * 装一个守卫，守卫在**同一份文件租约内**比较「打开时版本」与「盘上当前版本」，
+ * 不一致就抛冲突、一个字节都不写。
+ *
+ * ## 默认没有守卫 = 直接写（独立运行时行为逐字节不变）
+ *
+ * GenOffice 可以脱离 Mcode 单独运行。那时没有守卫，`guardedDocumentSave` 就是
+ * `ctx.write()` 的一层薄包装 —— **不改变任何可观测行为**。这一点有负控断言
+ * （O2 套件的 §5.2）：不装守卫时保存必须与改动前逐字节相同。
+ *
+ * ## 为什么 `write` 是回调，而不是「守卫自己写」
+ *
+ * 版本比较与写必须发生在**同一份租约**里。如果守卫只做「比较 → 返回 ok」、
+ * 然后由调用点再写，就是 TOCTOU：两个保存都读到旧版本、都通过比较、再先后
+ * rename —— 后者静默覆盖前者。Mcode 的 `documentViewHost.ts` 注释记过同一个坑。
+ * 把 `write` 传进去，守卫才能把「重算 → 比较 → 写」收进一个临界区。
+ *
+ * ## 只给四个保存调用点用，不挂 `atomicWriteFile`
+ *
+ * `atomicWriteFile` 同时服务导出、崩溃恢复、图片落盘、打印临时文件 —— 挂在那层
+ * 会把「导出」也算成「保存」，给不该拦的东西加锁。所以只有四个保存调用点调这里：
+ * html / markdown 的 `writeTextAtomic`、pdf 的 `writePdfAtomically`、
+ * slides 的 `slides:save`（`savePptxToFile` 是流式直写，不经过任何原子写层）。
+ */
+
+/** 这次保存的格式 —— 守卫用它选「哪个视图的打开版本」。 */
+export type DocumentSaveFormat = 'pdf' | 'markdown' | 'html' | 'slides'
+
+export interface DocumentSaveGuardContext {
+  /** 归一化后的目标路径（`realpath`，文件不存在时是 `resolve`）。 */
+  target: string
+  format: DocumentSaveFormat
+  /**
+   * 真正执行写盘的函数 —— 由调用点传入，**保证写发生在守卫的租约内**。
+   * 守卫可以在调用它之前拒绝（抛冲突），此时它**一次都不会被调用**。
+   */
+  write: () => Promise<void>
+}
+
+/** 守卫由宿主（Mcode）安装；独立运行时不装。 */
+export type DocumentSaveGuard = (ctx: DocumentSaveGuardContext) => Promise<void>
+
+let installed: DocumentSaveGuard | undefined
+
+/**
+ * 装/卸守卫。传 `undefined` 卸载（恢复独立运行时行为）。
+ *
+ * **只在装配期调用一次**：换守卫会留下不一致的打开版本绑定。
+ */
+export function setDocumentSaveGuard(guard: DocumentSaveGuard | undefined): void {
+  installed = guard
+}
+
+/** 当前是否装了守卫（诊断/断言用：没有这个，「守卫从来没被装上」与
+ *  「守卫装上了且正确」在判据里长得一样）。 */
+export function hasDocumentSaveGuard(): boolean {
+  return installed !== undefined
+}
+
+/**
+ * 写盘唯一出口。**没有守卫时与改动前逐字节等价**（直接调 `ctx.write()`）。
+ */
+export async function guardedDocumentSave(ctx: DocumentSaveGuardContext): Promise<void> {
+  if (!installed) return ctx.write()
+  return installed(ctx)
+}
+
+/* ───────────────────────── 暂存写 + 原子替换（失败不丢数据） ───────────────────────── */
+
+export interface StagedWriteDeps {
+  /** 写一份完整内容到给定路径。失败时**不得**留下半份文件是调用方的责任。 */
+  writeTo: (path: string) => Promise<void>
+  /** 目标路径。 */
+  target: string
+  /** 暂存路径（同目录、随机后缀）。 */
+  staging: string
+  /** 原子替换（默认 `rename`）；测试注入失败以覆盖失败路径。 */
+  replace?: (from: string, to: string) => Promise<void>
+  /** 删除文件（默认 `rm -f`）。测试可观察它被调用了几次、对哪个路径。 */
+  remove?: (path: string) => Promise<void>
+}
+
+/**
+ * 「写暂存 → 原子替换」的**唯一实现**，失败路径照抄 `atomic-write.ts` 的三段结构：
+ *
+ *  1. 写暂存失败 → 删暂存（里面没有完整内容）→ 抛；
+ *  2. 写成功、替换失败 → **不删暂存**（那是唯一一份完整的新内容），退回**原地写**；
+ *  3. 原地写也失败 → 暂存留着，错误信息点名它的位置。
+ *
+ * ## 为什么要有这个函数（而不是在调用点手写 try/catch/finally）
+ *
+ * 第一版把 `rm(staging)` 放在 `finally` 里 —— rename 失败时会把唯一的完整副本删掉，
+ * **用户看到「保存失败」而编辑全没了**，比不做原子写更坏（那时至少盘上还有被截断的
+ * 文件可捞）。失败路径没有任何正常路径的断言能覆盖它，所以它必须是一个**能被单独
+ * 喂假 replace/remove 的函数**，否则那条 bug 只能靠人读代码发现。
+ */
+export async function stagedAtomicWrite(deps: StagedWriteDeps): Promise<void> {
+  const replace = deps.replace ?? (async (from: string, to: string) => {
+    const { rename } = await import('node:fs/promises')
+    await rename(from, to)
+  })
+  const remove = deps.remove ?? (async (path: string) => {
+    const { rm } = await import('node:fs/promises')
+    await rm(path, { force: true })
+  })
+
+  try {
+    await deps.writeTo(deps.staging)
+  } catch (error) {
+    // 暂存没写完：删它是安全的（里面没有完整内容）。
+    await remove(deps.staging).catch(() => {})
+    throw error
+  }
+
+  // 到这里暂存里是**完整的新内容**。
+  try {
+    await replace(deps.staging, deps.target)
+    return
+  } catch (replaceError) {
+    try {
+      await deps.writeTo(deps.target)
+    } catch (fallbackError) {
+      // 两次都失败：**暂存留着**，并把它的位置写进错误（用户/我们才有机会捞回来）。
+      throw new Error(
+        `${String(fallbackError)} —— 保存失败，但新内容已完整写入 ${deps.staging}（原文件未改动）。` +
+          `目标文件可能被杀毒/同步软件锁住：稍后重试，或把上面那个文件改名回原文件。替换失败原因：${String(replaceError)}`,
+      )
+    }
+    // 原地写成功，暂存可以删了。
+    await remove(deps.staging).catch(() => {})
+  }
+}
-- 

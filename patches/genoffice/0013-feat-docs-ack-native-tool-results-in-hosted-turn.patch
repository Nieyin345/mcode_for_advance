+function utf8Bytes(value: string): number {
+  return new TextEncoder().encode(value).byteLength
+}
+function plainRecord(value: unknown): value is Record<string, unknown> {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) return false
+  const prototype = Object.getPrototypeOf(value)
+  return prototype === Object.prototype || prototype === null
+}
+function jsonRecordWithin(raw: unknown, maxBytes: number): Record<string, unknown> | null {
+  if (!plainRecord(raw)) return null
+  try {
+    const json = JSON.stringify(raw)
+    if (typeof json !== 'string' || utf8Bytes(json) > maxBytes) return null
+    const clone: unknown = JSON.parse(json)
+    return plainRecord(clone) ? clone : null
+  } catch {
+    return null
+  }
+}
+function parseToolDefinitions(raw: unknown): AgentToolDef[] | null {
+  if (!Array.isArray(raw) || raw.length > MAX_TOOL_DEFINITIONS) return null
+  const result: AgentToolDef[] = []
+  const names = new Set<string>()
+  let totalBytes = 0
+  for (const value of raw) {
+    if (
+      !plainRecord(value) ||
+      Object.keys(value).some((key) => !['name', 'description', 'inputSchema'].includes(key))
+    )
+      return null
+    if (
+      !validToolName(value.name) ||
+      names.has(value.name) ||
+      typeof value.description !== 'string' ||
+      value.description.length > 4_000
+    )
+      return null
+    const inputSchema = jsonRecordWithin(value.inputSchema, MAX_TOOL_SCHEMA_BYTES)
+    if (!inputSchema) return null
+    const definition = {
+      name: value.name,
+      description: value.description,
+      inputSchema,
+    } as AgentToolDef
+    const serialized = JSON.stringify(definition)
+    totalBytes += utf8Bytes(serialized)
+    if (totalBytes > MAX_TOOL_SCHEMA_BYTES) return null
+    names.add(value.name)
+    result.push(definition)
+  }
+  return result
+}
+function parseToolDefinition(raw: unknown): AgentToolDef | null {
+  const definitions = parseToolDefinitions([raw])
+  return definitions?.[0] ?? null
+}
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`
+  if (value && typeof value === 'object') {
+    const record = value as Record<string, unknown>
+    return `{${Object.keys(record)
+      .sort()
+      .map((key) => `${JSON.stringify(key)}:${canonicalJson(record[key])}`)
+      .join(',')}}`
+  }
+  return JSON.stringify(value) ?? 'undefined'
+}
+function normalizeToolCall(raw: unknown): AgentToolCall | null {
+  if (!plainRecord(raw) || !validRequestId(raw.id) || !validToolName(raw.name)) return null
+  if (
+    raw.inputError !== undefined &&
+    (typeof raw.inputError !== 'string' || raw.inputError.length > 2_000)
+  )
+    return null
+  if (raw.truncated !== undefined && typeof raw.truncated !== 'boolean') return null
+  const input = jsonRecordWithin(raw.input, MAX_TOOL_CALL_BYTES)
+  if (!input) return null
+  return {
+    id: raw.id,
+    name: raw.name,
+    input,
+    ...(typeof raw.inputError === 'string' ? { inputError: raw.inputError } : {}),
+    ...(raw.truncated === true ? { truncated: true } : {}),
+  }
+}
+function parseToolResultAck(raw: unknown): DocsAiToolResultAck | null {
+  if (!plainRecord(raw)) return null
+  const keys = Object.keys(raw).sort().join(',')
+  if (
+    keys !== 'callId,name,output,requestId,status' ||
+    !validRequestId(raw.requestId) ||
+    !validRequestId(raw.callId) ||
+    !validToolName(raw.name) ||
+    typeof raw.status !== 'string' ||
+    !['success', 'error', 'cancelled'].includes(raw.status) ||
+    typeof raw.output !== 'string'
+  )
+    return null
+  return raw as unknown as DocsAiToolResultAck
+}

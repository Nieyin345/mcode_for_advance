+function resolveAllPendingToolCalls(
+  active: ActiveRequest,
+  status: DocsAiToolResultStatus,
+  output: string,
+): void {
+  for (const callId of [...active.pendingToolCalls.keys()]) {
+    resolvePendingToolCall(active, callId, { status, output })
+  }

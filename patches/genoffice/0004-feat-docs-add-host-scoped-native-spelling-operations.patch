   'docs:close-check': { kind: 'on', to: 'mcode:document-view:close-check' },
   'menu:command': { kind: 'on', to: 'menu:command' },
@@ -115,6 +120,11 @@ export const mcodeDocsDesktopApi = Object.freeze({
   fontMetrics: (family: string) => invokeDocs('docs:font-metrics', family) as ReturnType<DesktopApi['fontMetrics']>,
   spellLanguages: () => invokeDocs('docs:spell-languages') as ReturnType<DesktopApi['spellLanguages']>,
   spellSetLanguages: (langs: string[]) => invokeDocs('docs:spell-set-languages', langs) as ReturnType<DesktopApi['spellSetLanguages']>,
+  spellAddWord: (word: string) => invokeDocs('docs:spell-add-word', word) as Promise<boolean>,
+  spellIgnoreWord: (word: string) => invokeDocs('docs:spell-ignore-word', word) as Promise<boolean>,
+  spellReplace: (word: string) => invokeDocs('docs:spell-replace', word) as Promise<void>,
+  spellDiag: (line: string) => { void invokeDocs('docs:spell-diag', line).catch(noop) },
+  respellKick: () => invokeDocs('docs:respell-kick') as Promise<void>,
   getRecentFiles: () => {
     // Native file-actions calls this after a successful open; Mcode uses it
     // as the commit acknowledgement, but stores no second recent-files list.

diff --git a/apps/docs/src/main/mcode-privileged.ts b/apps/docs/src/main/mcode-privileged.ts
new file mode 100644
index 0000000..fbb3a69
--- /dev/null
+++ b/apps/docs/src/main/mcode-privileged.ts
@@ -0,0 +1,269 @@
+/**
+ * T05b: privileged Docs IPC capabilities. The vendor never opens its own
+ * dialogs or has access to Mcode's project database. Every capability is a
+ * host-supplied port, selected by the actual sender's live DocumentViewHost.
+ */
+import type { IpcMain, IpcMainInvokeEvent } from 'electron'
+import { readFileSync, realpathSync, statSync } from 'node:fs'
+import { basename, dirname, extname, isAbsolute, join, relative, resolve } from 'node:path'
+import { randomUUID } from 'node:crypto'
+
+export interface DocsPrivilegedPorts {
+  pickFiles(filters?: Array<{ name: string; extensions: string[] }>): Promise<string[]>
+  pickImage(): Promise<{ base64: string; mime: 'image/png' | 'image/jpeg' | 'image/gif'; name: string } | null>
+  pickDirectory(): Promise<string | null>
+  saveTarget(name: string, ext: string): Promise<string | null>
+  confirmPrint(): Promise<boolean>
+  /** The Mcode pathGuard, not a vendor-owned list of workspace roots. */
+  workspaceRoot(path: string): string | null
+  /** Mcode's single atomic file writer, never node:fs.writeFile. */
+  atomicWrite(path: string, bytes: Uint8Array): Promise<void>
+  /** Remove only a consumed export temp, after validating its host-issued token. */
+  removeExportTemp(path: string): Promise<void>
+}
+
+type Event = IpcMainInvokeEvent
+type Permission = { sender?: Event['sender'] }
+type PortsFor = (event: Permission) => DocsPrivilegedPorts | null
+const prefix = 'mcode:docs:privileged-'
+export const DOCS_PRIVILEGED_CHANNELS = [
+  'pick-image', 'save-image-as', 'pick-export-images-target', 'take-export-pdf',
+  'printers', 'print', 'files-pick', 'files-add', 'files-read-image', 'write-export-image',
+].map((name) => prefix + name)
+
+const IMAGE_MIME: Readonly<Record<string, string>> = Object.freeze({
+  png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg',
+  gif: 'image/gif', webp: 'image/webp',
+})
+const EXTENSIONS = new Set([
+  'txt', 'md', 'markdown', 'json', 'csv', 'tsv', 'xml', 'html', 'htm', 'yaml',
+  'yml', 'js', 'jsx', 'ts', 'tsx', 'py', 'java', 'c', 'h', 'cpp', 'go',
+  'rs', 'rb', 'sh', 'sql', 'css', 'doc', 'docx', 'pdf', 'pptx', 'ppt',
+  'xlsx', 'xlsm', 'xls', ...Object.keys(IMAGE_MIME),
+])
+const ATTACHMENT_LIMIT = 20 * 1024 * 1024
+const IMAGE_LIMIT = 5 * 1024 * 1024
+const EXPORT_LIMIT = 80 * 1024 * 1024
+const denied = (reason: string) => ({ ok: false as const, error: reason })
+
+function within(root: string, path: string): boolean {
+  const rel = relative(root, path)
+  return rel === '' || (rel !== '..' && !rel.startsWith('..\\') &&
+    !rel.startsWith('../') && !isAbsolute(rel))
+}
+
+/** Enforce BOTH Mcode's persisted workspace decision and physical containment.
+ * A symlink/junction pointing outside the permitted root cannot escape. */
+function fenced(ports: DocsPrivilegedPorts, raw: unknown, writing = false): string | null {
+  if (typeof raw !== 'string' || !isAbsolute(raw) || raw.length > 4096) return null
+  const absolute = resolve(raw)
+  let root: string | null
+  try { root = ports.workspaceRoot(absolute) } catch { return null }
+  if (!root || !isAbsolute(root)) return null
+  try {
+    const realRoot = realpathSync(root)
+    const physical = writing
+      ? join(realpathSync(dirname(absolute)), basename(absolute))
+      : realpathSync(absolute)
+    if (!within(realRoot, physical)) return null
+    return absolute
+  } catch { return null }
+}
+
+function base64Bytes(raw: unknown, max: number): Uint8Array | null {
+  if (typeof raw !== 'string' || !raw.length || raw.length > Math.ceil(max * 4 / 3) + 8 ||
+      !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(raw)) return null
+  const buf = Buffer.from(raw, 'base64')
+  return buf.length <= max && buf.length > 0 ? buf : null
+}
+
+function attachment(path: string): { meta?: { path: string; name: string; ext: string; sizeBytes: number }; error?: string } {
+  const name = basename(path)
+  const ext = extname(name).slice(1).toLowerCase()
+  if (!EXTENSIONS.has(ext)) return { error: name + ': unsupported attachment extension' }
+  try {
+    const st = statSync(path)
+    if (!st.isFile() || st.size > ATTACHMENT_LIMIT ||
+      (Object.hasOwn(IMAGE_MIME, ext) && st.size > IMAGE_LIMIT)) {
+      return { error: name + ': attachment is not a regular file or exceeds the size limit' }
+    }
+    return { meta: { path, name, ext, sizeBytes: st.size } }
+  } catch { return { error: name + ': file cannot be accessed' } }
+}
+
+export function registerDocsPrivilegedIpc(
+  ipc: Pick<IpcMain, 'handle' | 'removeHandler'>,
+  portsFor: PortsFor,
+): () => void {
+  // Grants never come from renderer booleans/paths: only Mcode's own chooser.
+  const picked = new Map<number, Set<string>>()
+  const exportDirs = new Map<number, string>()
+  const tempPdfs = new Map<number, string>()
+  const seen = new WeakSet<object>()
+  const cleanupSender = (event: Event): void => {
+    if (!seen.has(event.sender)) {
+      seen.add(event.sender)
+      event.sender.once?.('destroyed', () => {
+        picked.delete(event.sender.id)
+        exportDirs.delete(event.sender.id)
+        tempPdfs.delete(event.sender.id)
+      })
+    }
+  }
+  const handle = (name: string, fn: (event: Event, ...args: unknown[]) => unknown): void => {
+    ipc.handle(prefix + name, (event, ...args) => {
+      const ports = portsFor(event)
+      if (!ports) return denied('Mcode Docs permission denied: not an authorized live document view')
+      cleanupSender(event)
+      return fn(event, ...args)
+    })
+  }
+  handle('pick-image', async (event) => {
+    const ports = portsFor(event)!
+    try { return await ports.pickImage() }
+    catch { return null }
+  })
+  handle('files-pick', async (event) => {
+    const ports = portsFor(event)!
+    try {
+      const paths = await ports.pickFiles([{ name: 'Documents', extensions: [...EXTENSIONS] }])
+      if (!paths.length) return null
+      const grants = picked.get(event.sender.id) ?? new Set<string>()
+      for (const path of paths) if (typeof path === 'string' && isAbsolute(path)) grants.add(resolve(path))
+      picked.set(event.sender.id, grants)
+      const accepted = []; const rejected = []
+      for (const path of paths) {
+        const result = attachment(path)
+        if (result.meta) accepted.push(result.meta)
+        else rejected.push(result.error ?? 'file refused')
+      }
+      return { accepted, rejected }
+    } catch { return { accepted: [], rejected: ['Mcode file picker unavailable'] } }
+  })
+  handle('files-add', (event, paths) => {
+    const ports = portsFor(event)!
+    if (!Array.isArray(paths) || paths.length > 32) return { accepted: [], rejected: ['invalid attachment paths'] }
+    const accepted = []; const rejected = []
+    for (const path of paths) {
+      if (typeof path !== 'string' || !isAbsolute(path) ||
+          (!fenced(ports, path) && !picked.get(event.sender.id)?.has(resolve(path)))) {
+        rejected.push('attachment path outside Mcode workspace or user selection')
+        continue
+      }
+      const result = attachment(path)
+      if (result.meta) accepted.push(result.meta)
+      else rejected.push(result.error ?? 'file refused')
+    }
+    return { accepted, rejected }
+  })
+  handle('files-read-image', (event, raw) => {
+    const ports = portsFor(event)!
+    const file = fenced(ports, raw)
+    if (!file) return denied('image path outside Mcode workspace')
+    const ext = extname(file).slice(1).toLowerCase()
+    if (!Object.hasOwn(IMAGE_MIME, ext)) return denied('not a supported image')
+    try {
+      const stat = statSync(file)
+      if (!stat.isFile() || stat.size > IMAGE_LIMIT) return denied('image exceeds size limit')
+      return { ok: true, base64: readFileSync(file).toString('base64'), mime: IMAGE_MIME[ext] }
+    } catch { return denied('image cannot be read') }
+  })
+  handle('printers', async (event) => {
+    try {
+      // Return only printer identity needed by the Docs UI. Never log OS inventory.
+      const printers = await event.sender.getPrintersAsync()
+      return printers.map((p) => ({ name: p.name, displayName: p.displayName || p.name }))
+    } catch { return [] }
+  })
+  handle('print', async (event, rawScale, rawJob) => {
+    const ports = portsFor(event)!
+    // Every attempt requires a fresh *human* approval (no persisted or renderer grant).
+    if (!await ports.confirmPrint().catch(() => false)) return denied('print was not confirmed by the user')
+    if (rawScale !== undefined &&
+        (typeof rawScale !== 'number' || !Number.isFinite(rawScale) || rawScale <= 0 || rawScale > 5)) {
+      return denied('invalid print scale')
+    }
+    const job = rawJob as { deviceName?: unknown; copies?: unknown; collate?: unknown; duplex?: unknown } | null
+    if (job !== null && job !== undefined && (typeof job !== 'object' || Array.isArray(job) ||
+        (job.deviceName !== null && job.deviceName !== undefined && typeof job.deviceName !== 'string') ||
+        (typeof job.deviceName === 'string' && job.deviceName.length > 256) ||
+        (job.copies !== undefined && (!Number.isInteger(job.copies) || (job.copies as number) < 1 || (job.copies as number) > 99)) ||
+        (job.collate !== undefined && typeof job.collate !== 'boolean') ||
+        (job.duplex !== undefined && !['simplex', 'longEdge', 'shortEdge'].includes(String(job.duplex))))) {
+      return denied('invalid printer options')
+    }
+    return new Promise((resolveReply) => event.sender.print({
+      margins: { marginType: 'none' },
+      ...(typeof rawScale === 'number' ? { scaleFactor: Math.round(rawScale * 100) } : {}),
+      ...(job?.deviceName !== null && job?.deviceName !== undefined
+        ? { silent: true, deviceName: job.deviceName as string } : {}),
+      ...(job?.copies !== undefined ? { copies: job.copies as number } : {}),
+      ...(job?.collate !== undefined ? { collate: job.collate as boolean } : {}),
+      ...(job?.duplex !== undefined ? { duplexMode: job.duplex as 'simplex' | 'longEdge' | 'shortEdge' } : {}),
+    }, (ok, error) => resolveReply(ok ? { ok: true } : denied(error || 'printer canceled'))))
+  })
+  handle('save-image-as', async (event, src) => {
+    const ports = portsFor(event)!
+    if (typeof src !== 'string') return denied('invalid image source')
+    const match = /^data:image\/(png|jpeg|gif|webp);base64,(.*)$/s.exec(src)
+    if (!match) return denied('only embedded image data can be saved by Mcode')
+    const bytes = base64Bytes(match[2], IMAGE_LIMIT)
+    if (!bytes) return denied('invalid or oversized image')
+    const ext = match[1] === 'jpeg' ? 'jpg' : match[1]!
+    try {
+      const target = await ports.saveTarget('image.' + ext, ext)
+      if (!target) return denied('image save canceled')
+      const file = fenced(ports, target, true)
+      if (!file || extname(file).toLowerCase() !== '.' + ext) return denied('image save target outside Mcode workspace')
+      await ports.atomicWrite(file, bytes)
+      return { ok: true, path: file }
+    } catch { return denied('Mcode image save failed') }
+  })
+  handle('pick-export-images-target', async (event) => {
+    const ports = portsFor(event)!
+    const dir = await ports.pickDirectory().catch(() => null)
+    const safe = dir ? fenced(ports, dir) : null
+    if (!safe) return null
+    try { if (!statSync(safe).isDirectory()) return null } catch { return null }
+    const temp = join(safe, '.mcode-docs-export-' + randomUUID() + '.pdf')
+    if (!fenced(ports, temp, true)) return null
+    exportDirs.set(event.sender.id, safe)
+    tempPdfs.set(event.sender.id, temp)
+    return { dir: safe, pdfPath: temp }
+  })
+  handle('take-export-pdf', async (event, raw) => {
+    const ports = portsFor(event)!
+    const expected = tempPdfs.get(event.sender.id)
+    tempPdfs.delete(event.sender.id)
+    if (!expected || raw !== expected || !fenced(ports, expected)) {
+      return denied('PDF is not an authorized workspace export temp')
+    }
+    try {
+      const st = statSync(expected)
+      if (!st.isFile() || st.size > EXPORT_LIMIT) return denied('export PDF exceeds size limit')
+      // Deliberately do not delete an unverified path; caller only receives
+      // bytes from an exact host-issued export token.
+      return { ok: true, base64: readFileSync(expected).toString('base64') }
+    } catch { return denied('authorized export PDF is not available') }
+    finally { await ports.removeExportTemp(expected).catch(() => undefined) }
+  })
+  handle('write-export-image', async (event, rawDir, rawName, rawBytes) => {
+    const ports = portsFor(event)!
+    const allowedDir = exportDirs.get(event.sender.id)
+    if (!allowedDir || rawDir !== allowedDir || !fenced(ports, allowedDir) ||
+        typeof rawName !== 'string' || !/^[^/\\]+\.png$/i.test(rawName) ||
+        rawName === '.' || rawName === '..') {
+      return denied('image export target is not a user-approved workspace folder')
+    }
+    const bytes = base64Bytes(rawBytes, IMAGE_LIMIT)
+    if (!bytes) return denied('invalid or oversized PNG')
+    const file = join(allowedDir, rawName)
+    if (!fenced(ports, file, true)) return denied('image export escapes workspace')
+    try { await ports.atomicWrite(file, bytes); return { ok: true, path: file } }
+    catch { return denied('Mcode image export write failed') }
+  })
+  return () => {
+    for (const ch of DOCS_PRIVILEGED_CHANNELS) ipc.removeHandler(ch)
+    picked.clear(); exportDirs.clear(); tempPdfs.clear()
+  }
+}

+    invokeDocs('docs:save-merged-pdf', name, parts, path, links) as ReturnType<DesktopApi['saveMergedPdf']>,
   listPrinters: () => invokeDocs('docs:printers') as ReturnType<DesktopApi['listPrinters']>,
   print: (scale?: number, job?: Parameters<DesktopApi['print']>[1]) =>
     invokeDocs('docs:print', scale, job) as ReturnType<DesktopApi['print']>,
   pickAttachments: () => invokeDocs('files:pick') as ReturnType<DesktopApi['pickAttachments']>,
   addAttachmentPaths: (paths: string[]) => invokeDocs('files:add', paths) as ReturnType<DesktopApi['addAttachmentPaths']>,
   readAttachmentImage: (path: string) => invokeDocs('files:read-image', path) as ReturnType<DesktopApi['readAttachmentImage']>,
+  readAttachment: (path: string, offset: number, maxChars: number) =>
+    invokeDocs('files:read', path, offset, maxChars) as ReturnType<DesktopApi['readAttachment']>,

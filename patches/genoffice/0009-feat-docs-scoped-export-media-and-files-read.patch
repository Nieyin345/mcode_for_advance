+export async function readLazyMedia(url: string, ownerId?: number): Promise<{ body: Buffer; mime: string } | null> {
   const ref = parseLazyMediaUrl(url)
   if (!ref || !isLazyMediaPart(ref.partPath)) return null
+  // Mcode's renderer-scoped privileged route passes its actual webContents id.

   pickImage: () => invokeDocs('docs:pick-image') as ReturnType<DesktopApi['pickImage']>,
-  saveImageAs: (src: string) => invokeDocs('docs:save-image-as', src) as ReturnType<DesktopApi['saveImageAs']>,
+  saveImageAs: async (src: string) => {
+    // Only blob:/docx-media: are dereferenced in the isolated browser process.
+    // Never let a renderer-supplied http(s) URL invoke fetch here: it must go
+    // through the Mcode main-process one-shot approval and pinned DNS route.
+    if (/^(blob:|genoffice-docx-media:)/i.test(src)) {
+      try {
+        const response = await fetch(src)
+        if (!response.ok) return { ok: false, error: 'lazy image could not be loaded' }
+        const data = await response.blob()
+        const mime = data.type.toLowerCase()
+        if (!/^image\/(png|jpeg|gif|webp)$/.test(mime) || data.size > 5 * 1024 * 1024) {
+          return { ok: false, error: 'lazy image is not a supported image under 5 MiB' }
+        }
+        const bytes = new Uint8Array(await data.arrayBuffer())
+        let binary = ''
+        for (let i = 0; i < bytes.length; i += 8192) {
+          binary += String.fromCharCode(...bytes.subarray(i, i + 8192))
+        }
+        src = 'data:' + mime + ';base64,' + btoa(binary)
+      } catch { return { ok: false, error: 'lazy/blob image cannot be loaded by this view' } }
+    }
+    return invokeDocs('docs:save-image-as', src) as ReturnType<DesktopApi['saveImageAs']>
+  },

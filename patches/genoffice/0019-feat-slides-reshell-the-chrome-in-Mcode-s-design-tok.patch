index f15cb46..3a5da93 100644
--- a/apps/slides/src/renderer/main.tsx
+++ b/apps/slides/src/renderer/main.tsx
@@ -17,6 +17,20 @@ import '@genoffice/ui/markdown.css'
 import '@genoffice/ui/ai-panel-prefs.css'
 import '@genoffice/ui/ai-scope-quote.css'
 import './styles.css'
+// 【O6】Mcode 宿主主题层：把 GenOffice 的语义 token 重指到 Mcode 的 CDS 色阶。
+// **只在 Mcode 里加载** —— 单独跑 GenOffice 时保持自己的视觉语言。
+//
+// ⚠️ 这里**绝不能**抄 docs 的 `if (window.desktop)`: slides 的 preload **也** expose
+// 了 `desktop`（src/preload/index.ts:499，那是文件附件 API `filesApi`），那个守卫
+// 在本 app 上恒为真 —— 独立运行也会被换壳。docs 那边已经实际发生过这件事。
+//
+// 用 UA 里的产品号：Electron 默认把 `app.getName()` 写进 UA 注释段。Mcode 主进程
+// 在 whenReady 之前 `app.setName("Mcode")`（apps/desktop/src/main/index.ts:101），
+// 且文档视图不覆盖 UA —— 所以宿主里是 `Mcode/44.x`，单独跑是 `GenOfficeSlides/44.x`。
+// 真 Electron 双模式实测见 apps/desktop/scripts/o6-reshell-slides-smoke/。
+//
+// 放在 `styles.css` 之后：token 是自定义属性，后者先定义、这里覆盖，顺序决定胜负。
+if (/\bMcode\//.test(navigator.userAgent)) import('./mcode-theme.css')
 import { applyAiPanelPrefs, installScreenTips } from '@genoffice/ui'
 
 installScreenTips()

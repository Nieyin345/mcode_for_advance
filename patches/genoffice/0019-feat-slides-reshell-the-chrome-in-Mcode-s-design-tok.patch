@@ -0,0 +1,247 @@
+/* Mcode 宿主主题层（Slides）—— 把 GenOffice 的**语义 token** 重指到 Mcode 的 CDS 色阶。
+ *
+ * ## 这是什么，不是什么
+ *
+ * 与 docs（0014）、html（0016）、markdown（0017）、pdf（0018）同一套机制、同一批取值：
+ * chrome 颜色全部走 `packages/ui/src/tokens.css` 的语义 token，换壳 = 替换 token 取值。
+ * 组件树、Konva 画布、deck 模型、放映与导出路径一行不动。
+ *
+ * 覆盖集与 docs 那份**逐字相同**（54 个共享 chrome token）。
+ *
+ * ## ★ 为什么这里绝不能抄 docs 的 `window.desktop` 守卫
+ *
+ * docs 用 `if (window.desktop)`。**slides 的 preload 也 expose 了 `desktop`**
+ * （`apps/slides/src/preload/index.ts:499`，那是文件附件 API `filesApi`），
+ * 所以那个守卫在 slides 上**恒为真** —— 独立运行也会被换壳，与 0014 在 docs 上
+ * 实际发生的事同型（我们实测过）。
+ *
+ * 这里用 **UA 产品号**：Electron 默认把 `app.getName()` 写进 UA 注释段。Mcode 主进程
+ * 在 `whenReady` 之前 `app.setName("Mcode")`，且文档视图不覆盖 UA —— 宿主里是
+ * `Mcode/44.x`，单独跑是 `GenOfficeSlides/44.x`。真 Electron 双模式实测见
+ * `apps/desktop/scripts/o6-reshell-slides-smoke/`。
+ *
+ * ## 边界（硬规矩）
+ *
+ * **规则 A：换壳 = 换共享 token，app 私有 token 一律不动。**
+ * slides 有 138 个 app 私有 token，绝大多数是**内容/语义**色，用户靠它们认
+ * 「这是演示文稿的哪一类标记」：
+ *
+ * - `--slides-paper`（幻灯片纸张）
+ * - `--slides-show-*`（放映模式的深色底与各级墨色 —— 放映时不跟 UI 主题）
+ * - `--slides-anim-*`（动画类型色标：进入/强调/退出/路径）
+ * - `--slides-crop-*` / `--slides-guide` / `--slides-grid-line`（裁剪与参考线）
+ * - `--slides-laser-*`（激光笔）
+ * - `--slides-reading-*`（阅读视图）
+ *
+ * **`canvas-colors.ts` 不在这里动**：它只有 `redactFrame` 三个值（stroke/chip/label），
+ * 注释明写「红框随图片进缩略图，两种主题画得一样」—— 那是脱敏标记，不是 chrome。
+ *
+ * 也不碰 `--accent*`（品牌色）、`--search-hit-*` / `--docs-revision-bar`（文档语义标记）。
+ *
+ * ## 渲染窗（`?mode=audience`）
+ *
+ * `main.tsx` 的 `mode === 'audience'` 分支不调 `applyTheme`（放映窗不跟 UI 主题）。
+ * 本文件只覆盖 `:root` 与 `[data-theme='dark']` 的 token；放映窗不设 `data-theme`，
+ * 但**仍会加载本文件**（开关在模块顶层）。放映窗的外观由 `--slides-show-*` 自己决定，
+ * 那些 token 不在覆盖集里 —— 所以放映不受影响。
+ */
+
+/* ── 亮色 ─────────────────────────────────────────────────────────────── */
+:root {
+  /* 表面阶梯 → CDS gray 阶（Mcode 的 --surface = var(--m-gray-10) = #fcfcfb） */
+  --surface: #fcfcfb;
+  --surface-subtle: #f9f9f7;
+  --chrome-bg: #fcfcfb;
+  --canvas: #f0efec;
+  --bg-content: #f9f9f7;
+
+  /* 边框 → CDS 发丝边 */
+  --border: #e1e0d9;
+  --border-subtle: #edece8;
+  --border-strong: #d2d1c7;
+  --border-hover: #c3c2b7;
+
+  /* 文字 → CDS 对比阶梯（Mcode 的 --content = var(--m-gray-850) = #151515） */
+  --text: #151515;
+  --text-primary: #151515;
+  --text-secondary: #52514e;
+  --text-tertiary: #6d6b67;
+  --text-muted: #6d6b67;
+  --text-dim: #52514e;
+
+  /* 交互态 */
+  --hover: #f0efec;
+  --pressed: #eae9e4;
+  --active-bg: #e1e0d9;
+  --bg-hover: #f0efec;
+  --bg-hover-subtle: #f6f6f4;
+  --bg-hover-strong: #eae9e4;
+  --bg-hover-accent: #e1e0d9;
+  --icon-muted: #a5a49a;
+
+  /* 状态色：保留语义，只换到 CDS 色系的饱和度 */
+  --danger: #b4352f;
+  --danger-bg: #fdf3f2;
+  --danger-border: #f0c8c4;
+  --success: #2f6b4a;
+  --success-bg: #eef6f1;
+  --success-border: #c8e0d2;
+
+  /* 阴影：CDS 的头发丝阴影 */
+  --shadow-btn-hover: 0 1px 3px rgb(21 21 21 / 8%);
+  --shadow-modal-strong: 0 12px 32px rgb(21 21 21 / 12%);
+  --shadow-menu: 0 6px 20px rgb(21 21 21 / 14%);
+
+  /* 主按钮 / AI 动作：Claude 的陶土橙不是 GenOffice 的 #e8663f */
+  --color-btn-primary: #151515;
+  --color-btn-primary-hover: #2c2c2a;
+  --color-btn-primary-text: #fcfcfb;
+  --color-ai-action: #c96442;
+  --color-ai-action-hover: #b55538;
+  --color-ai-action-text: #fcfcfb;
+  --color-brand-secondary: #c96442;
+  --color-border-brand: #c96442;
+
+  /* 与 chrome 同名的重复语义（AI 面板沿用这一组） */
+  --color-text-primary: #151515;
+  --color-text-secondary: #52514e;
+  --color-text-tertiary: #6d6b67;
+  --color-bg-page: #fcfcfb;
+  --color-bg-subtle: #f9f9f7;
+  --color-border-default: #e1e0d9;
+  --color-border-strong: #d2d1c7;
+  --color-error: #b4352f;
+  --color-error-hover: #9c2c27;
+
+  /* 字体族：Mcode 用系统 sans 栈，不用 Arial 打头 */
+  --gs-font-sans:
+    -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', Roboto, 'Helvetica Neue', sans-serif;
+
+  /* 圆角：CDS 比 Word 更圆一档 */
+  --radius-6: 6px;
+  --radius-8: 8px;
+  --radius-12: 12px;
+  --radius-16: 16px;
+}
